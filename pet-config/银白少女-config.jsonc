{
  // ============================================================================
  // 文件宠物：银白少女（pet pack）—— v5：**只保留可灵 AI 生成的动画**
  //
  // 为什么只剩 19 条：106 条里只有 20 条是可灵 AI 真生成的（有真实的转身、位移、
  // 披风扫动、幅度到位），另外 86 条是程序化引擎绘制的「同一张立绘 + 轻微动作」，
  // 两条路线放在一起观感差距一眼可见。「东张西望」的可灵原片有生成事故
  // （t>=2s 起画面里出现 3 个克隆人），已弃用 → 20 - 1 = 19 条。
  //
  // 素材来源：work\ai-video-backup\*.mp4（20 条可灵原片，逐字节备份）
  //   动画：pet/银白少女-animation/<动画名>.webm （只放这 19 个）
  //   表情：pet/银白少女-memes/<名称>.png （4 张）
  //
  // 与 v4（106 条）的两处结构差异——都不是随手删的，是插件 schema/行为决定的：
  //   1) categories 池留空：80 条随机小动作全是程序化出的，没有 AI 片可放。
  //      空池合法（client.js:pickWeightedCategory 会过滤掉 actions 为空的分类，
  //      全空返回 null → pickCategoryAction 回落 idle 池）。为保持原来的「走动频率」，
  //      把 animationWeights 的 idle 从 10 提到 90，把内置给分类池的 80 份额吸收掉。
  //   2) turn 池放「原地左转奔跑」这条 AI 片（它本来在 moves 里，见下）。
  //      ⚠️ turn 池绝不能留空：client.js:3511 算移动方向用的是
  //         dir = (facing === "right") !== turn.includes(当前动画) ? 1 : -1
  //      而换朝向**只发生在转向动画播完时**（client.js:3431-3434）。
  //      turn 池空 → facing 永远不变 → 宠物只会朝一个方向走，撞到屏幕边
  //      planMove 返回 null、tryMove 返回 false，之后再也不走（卡死）。
  //      所以必须有且只有一条「专属转向片」：它只能出现在 turn 池里，
  //      一旦同时也是 moves.actions 的一员，每次走完都会再翻一次朝向（镜像抖动）。
  //   3) events.balance 必须非空：index.js:animationsValid 硬校验 balance.length > 0，
  //      空了整份配置会被判非法。所以 6 档余额改成「借用 AI 事件片」按情绪映射，
  //      不再有专门的数钱/钱袋画面（要恢复的话把那 6 条 余额-*.webm 放回来即可）。
  //
  // 原有 main-config.jsonc（蓝毛小女仆 / 蓝毛小肥鱼）保持不动，本文件是**额外**的第 3 只宠物。
  // ============================================================================

  "pets": [
    {
      "id": "银白少女",
      "name": "银白少女",
      "size": 462,
      "balanceEnabled": true,
      "whisperEnabled": true,
      "workStatusEnabled": true,
      "fixedEnabled": false,
      "display": "both",
      "position": { "corner": "bottom-right", "marginX": 24, "marginY": 48 }
    }
  ],

  // 独立人设：只影响本条目下的宠物（main 条目的蓝发女仆人设不受影响）
  "whisperPrompt": "你是主人桌面上的Q版银白长发少女：银白色蓬松长卷发过腰，黑色宽发箍上一枚薄荷绿菱形纹，头侧一枚薄荷绿叶形发饰，眼睛是紫粉到浅蓝的渐变，深蓝黑短披风下摆薄荷绿渐层缀白色五瓣花，胸前一枚橙色蝶翼状宝石胸针。性格温柔安静、轻盈带一点俏皮。会时不时碎碎念一句，说话自然随意、短短一句（20字以内），说人话不啰嗦，不要解释你自己，不要提你是AI。",

  // 表情包：键 = pet/银白少女-memes/<键>.png，值 = 该图内容描述（模型按语境选图）
  "memes": {
    "微笑": "温柔抿嘴微笑，适合平静、日常应答、心情不错",
    "眨眼": "俏皮眨单眼，适合玩笑、调皮、轻松调侃",
    "惊讶": "睁大眼睛吃惊，适合意外、突发、被吓一跳",
    "害羞": "脸红低头害羞，适合被夸奖、撒娇、不好意思"
  },

  // 随机链权重：idle 90 / turn 5 / move 5（合计 100）。
  // 内置默认是 idle 10 / turn 5 / move 5 + 分类池 80；这里分类池空，把那份份额并入 idle，
  // 于是「走动/转向的触发频率」和内置宠物一致，其余时间都在待机。
  "animationWeights": { "idle": 90, "turn": 5, "move": 5 },

  "animations": {
    // 待机动画池：只有一条 AI 片（没有别的 AI 待机可选，所以永远播它）
    "idle": ["待机呼吸休闲"],
    // 转向动画池：**必须非空**，且只能是「专属转向片」（见文件头说明 2）。
    // 用 AI 片「原地左转奔跑」——它本身就是一个边跑边转身的动作，当转向用正好；
    // 因为不能再兼任 moves 里的移动片，已从下面的 moves.actions 移除。
    "turn": ["原地左转奔跑"],
    // 拖拽动画池（被无形抓起悬空的姿势）
    "drag": ["被鼠标拖拽悬空反馈"],

    // 点击回应：5 条 AI 片随机播放
    "clicks": [
      "点击回应-开心跃动",
      "点击回应-害羞惊讶",
      "点击回应-傲娇生气",
      "点击回应-挠痒咯咯笑",
      "点击回应-元气挥手"
    ],

    // 移动：走路/漂浮，2 条 AI 片，参数沿用内置默认（相对基准宠物宽 462px）
    "moves": {
      "default": { "minDist": 60, "maxDist": 240, "margin": 20, "leadSec": 2, "tailSec": 2 },
      "actions": [
        { "name": "螃蟹走路" },
        { "name": "原地漂浮踏步", "params": { "minDist": 40, "maxDist": 120 } }
      ]
    },

    // 随机动作：分类池留空（80 条小动作全是程序化出的，见文件头说明 1）。
    // 想加回来任意一条，只要 actions 里写上名字、并把 animationWeights 的
    // idle+move 调低给分类腾出份额即可。
    "categories": [],

    // 事件动画：不进随机链，只由代码显式触发（数组索引 = 档位，勿在中间插档）
    "events": {
      // balance：按余额已用百分比分档，index = p===100 ? 5 : floor(p/20)
      // 没有 AI 生成的数钱/钱袋片（那 6 条是程序化的），这里借用 AI 的**事件片**按情绪
      // 映射出「越穷越沮丧」的梯度。余额数字本身由气泡单独显示，不受影响。
      //
      // ⚠️ 只能用「纯事件片」（工作状态-* / 碎碎念-*）当别名，不能借 idle/clicks/moves 里的名字：
      // client.js:3405 的 isEventAnim(events, 当前动画) 会据此决定「播完怎么办」。
      // 如果把 idle 里的「待机呼吸休闲」写进 events，那么每次待机播完都会被判成事件动画，
      // 走 3423 行的分支直接重播待机、**永远不会回到 pickNext() 抽下一条** →
      // 随机链（走动 10%）就彻底失效了。clicks 的名字（如 点击回应-开心跃动）虽然
      // 终局行为恰好等价，但为了让「事件池只放纯事件片」这条规则简单可查，这里也不用。
      // 副作用：这些名字同时也在 workStatus 池里，若余额刷新时正好有工作状态在跑，
      // handleEnded 会走 3416 行「档内循环续播」把它loop下去（视觉上就是继续做那个动作），
      // 状态结束后由 workStatus 分支收尾，不会卡死。
      "balance": [
        "工作状态-雀跃庆祝",     // 0 ≤ p < 20（几乎未消耗 → 庆祝）
        "工作状态-清点归档",     // 20 ≤ p < 40（盘点家底）
        "工作状态-思考冒泡",     // 40 ≤ p < 60（盘算着花）
        "工作状态-原地踱步张望", // 60 ≤ p < 80（开始踱步发愁）
        "工作状态-垂头叹气冒汗", // 80 ≤ p < 100（告急 → 叹气冒汗）
        "工作状态-垂头叹气冒汗"  // p === 100（全部用完，格外档）
      ],
      // whisper：到点随机抽 1 段播（等概率），3 条都是 AI 片
      "whisper": [
        "碎碎念-擦桌碎碎念",
        "碎碎念-发呆碎碎念",
        "碎碎念-对屏碎碎念"
      ],
      // workStatus：索引 = 状态档位，6 条都是 AI 片
      //   0 thinking / 1 working / 2 result / 3 waiting / 4 success / 5 error
      "workStatus": [
        "工作状态-思考冒泡",
        "工作状态-忙碌点按",
        "工作状态-清点归档",
        "工作状态-原地踱步张望",
        "工作状态-雀跃庆祝",
        "工作状态-垂头叹气冒汗"
      ]
    }
  }
}
